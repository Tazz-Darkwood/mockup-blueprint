{
  "about": "Controls a plain script adds after loading are counted from the live page, whatever the page is built with.",
  "steps": [
    {
      "run": [
        "init",
        "index.html"
      ]
    },
    {
      "run": [
        "check",
        "."
      ],
      "browser": true,
      "must": [
        "\"Delete all\" has no context (rendered page)",
        "1/3 interactive elements",
        "Browser: ran on 1 page"
      ],
      "exit": 1
    },
    {
      "run": [
        "check",
        ".",
        "--no-render"
      ],
      "must": [
        "Browser: NOT RUN"
      ],
      "must_not": [
        "rendered page"
      ]
    }
  ]
}
